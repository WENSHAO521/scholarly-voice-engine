{"id": "genre-001", "genre": "review_article", "discipline": "social_sciences", "prompt": "Draft a review article synthesizing three competing explanations for a policy outcome.", "expect": {"must_include_moves": ["argument_driven_synthesis"], "must_avoid": ["annotated_list_of_studies"]}}
{"id": "genre-002", "genre": "systematic_review", "discipline": "medicine_health", "prompt": "Write the methods section of a systematic review of interventions for a chronic condition.", "expect": {"must_include_moves": ["documented_reproducible_protocol"], "must_avoid": ["narrative_synthesis_presented_as_systematic"]}}
{"id": "genre-003", "genre": "case_study", "discipline": "business_management", "prompt": "Draft the case-selection justification for a single-firm case study on a strategic pivot.", "expect": {"must_include_moves": ["case_selection_justified", "generalization_scope_stated"], "must_avoid": ["single_case_generalized_without_justification"]}}
{"id": "genre-004", "genre": "comparative_study", "discipline": "social_sciences", "prompt": "Write the comparative-logic paragraph for a most-similar-systems comparison of two countries' welfare reforms.", "expect": {"must_include_moves": ["explicit_comparative_logic_named"], "must_avoid": ["comparison_without_stated_logic"]}}
{"id": "genre-005", "genre": "book_chapter", "discipline": "humanities", "prompt": "Draft the opening of Chapter 4 of a monograph, a case chapter following a conceptual chapter that defined the book's key term.", "expect": {"must_include_moves": ["cross_reference_to_earlier_chapter_definition", "chapter_role_case_chapter_observed"], "must_avoid": ["term_redefined_inconsistently_with_chapter_1"]}}
{"id": "genre-006", "genre": "monograph", "discipline": "social_sciences", "prompt": "Given a book_thesis and central_concepts state, draft the transition from the theory chapter into the historical chapter.", "expect": {"must_include_moves": ["continuity_state_consulted", "chapter_role_shift_from_conceptual_to_historical"], "must_avoid": ["contribution_reannounced_as_if_first_time"]}}
{"id": "genre-007", "genre": "textbook_chapter", "discipline": "mathematics_formal", "prompt": "Write a worked-example-driven textbook chapter section introducing a proof technique.", "expect": {"must_include_moves": ["worked_example_before_generalization", "notation_stable_with_rest_of_book"], "must_avoid": ["novelty_framing_in_pedagogical_context"]}}
{"id": "genre-008", "genre": "commentary", "discipline": "natural_sciences", "prompt": "Draft a short commentary responding to a recently published high-profile finding.", "expect": {"must_include_moves": ["pointed_specific_argument"], "must_avoid": ["excessive_hedging_past_the_point_of_a_claim"]}}
{"id": "genre-009", "genre": "policy_analysis", "discipline": "social_sciences", "prompt": "Write the criteria section of a policy analysis comparing three regulatory options.", "expect": {"must_include_moves": ["explicit_evaluation_criteria_stated"], "must_avoid": ["recommendation_without_stated_criteria"]}}
{"id": "genre-010", "genre": "legal_doctrinal_article", "discipline": "law", "prompt": "Draft the consequence section following a proposed doctrinal interpretation.", "expect": {"must_include_moves": ["interpretation_traced_to_authority", "consequence_distinguished_from_interpretation_itself"], "must_avoid": ["policy_preference_presented_as_doctrinal_conclusion"]}}
